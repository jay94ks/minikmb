+#if defined(STM32H743xx) && defined(USB_OTG_HS_PERIPH_BASE)
+// Read an ordered AHB register once per minimum bus cycle to avoid CPU clock assumptions.
+static void stm32h743_wait_usb_ahb(const dwc2_regs_t* dwc2, unsigned cycles) {
+  __DSB();
+  for (unsigned i = 0; i < cycles; ++i) {
+    (void) dwc2->gahbcfg;
+  }
+}
+
+// ES0392 §2.25.7: keep the IN endpoint in NAK while the core arms a ZLP.
+static void stm32h743_arm_in_zlp(dwc2_regs_t* dwc2, dwc2_dep_t* dep,
+                               uint32_t enabled, const uint8_t* buffer) {
+  const uint32_t nak = (enabled & ~(DIEPCTL_CNAK | DIEPCTL_EPENA)) | DIEPCTL_SNAK;
+  if (dma_device_enabled(dwc2)) {
+    dep->diepdma = (uintptr_t) buffer;
+  } else {
+    dep->diepctl = nak;
+    stm32h743_wait_usb_ahb(dwc2, 20);
+  }
+  dep->diepctl = nak | DIEPCTL_EPENA;
+  stm32h743_wait_usb_ahb(dwc2, 15);
+  dep->diepctl = enabled & ~DIEPCTL_SNAK;
+}
+#endif
+
