 TU_ATTR_ALWAYS_INLINE static inline bool queue_event(dcd_event_t const * event, bool in_isr) {
+#ifdef MINIKMB_TUSB_TARGET_INSTANCE
+  if (_usbd_event_queue_overflow) {
+    return false;
+  }
+
+  // A lost transfer event makes endpoint state unreliable. Stop the producer;
+  // the target task retires this queue and reconnects the target controller.
+  bool const queued = in_isr ? osal_queue_send(_usbd_q, event, true) :
+                               xQueueSendToBack(_usbd_q, event, 0) != pdFALSE;
+  if (!queued) {
+    _usbd_event_queue_overflow = true;
+    dcd_int_disable(event->rhport);
+    return false;
+  }
+#else
   TU_ASSERT(osal_queue_send(_usbd_q, event, in_isr));
+#endif
   tud_event_hook_cb(event->rhport, event->event_id, in_isr);
   return true;
 }
